# ==============================================================================
# GateKeeper-DBF - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as configurações do seu ambiente.
# NUNCA envie o arquivo .env real para o controle de versão (Git).
# ==============================================================================

# Segurança da Aplicação
# Gere uma chave segura em produção: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-aqui

# Modo de Depuração (Defina como False em ambientes de produção)
DEBUG=True

# Hosts Permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de Dados (Padrão: SQLite para desenvolvimento)
# Para PostgreSQL: postgres://usuario:senha@localhost:5432/gatekeeper_db
DATABASE_URL=sqlite:///db.sqlite3

# Diretivas de Segurança HTTPS / Cookies (True em Produção com SSL)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

