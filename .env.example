# ==============================================================================
# GateKeeper-DBF - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as configurações do seu ambiente.
# NUNCA envie o arquivo .env real para o controle de versão (Git).
# ==============================================================================

# Segurança da Aplicação
# Gere uma chave segura em produção: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-aqui

# Modo de Depuração (Defina como False em ambientes de produção)
DEBUG=True

# Hosts Permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de Dados (Padrão: SQLite para desenvolvimento)
# Para PostgreSQL: postgres://gatekeeper:senha_forte@localhost:5432/gatekeeper_db
DATABASE_URL=sqlite:///db.sqlite3

# Diretivas de Segurança HTTPS / Cookies (Fase 8.6)
# Por padrão seguro, quando DEBUG=False, Django ativa cookies Secure e redirecionamento SSL automaticamente.
# Descomente as linhas abaixo SOMENTE para desenvolvimento local isolado sem HTTPS:
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_SSL_REDIRECT=False

# Confiança em Proxy Reverso (Caddy / Nginx / Traefik) (Fase 7.1 / 8.2)
# Defina TRUSTED_PROXY_COUNT=1 e USE_X_FORWARDED_PROTO=True quando estiver atrás de um proxy TLS
TRUSTED_PROXY_COUNT=0
USE_X_FORWARDED_PROTO=False
DOMAIN=localhost

# Backup com Criptografia Assimétrica age (Fase 8.4)
# Chave pública para encriptação dos dumps do banco de dados (ex: age1...)
# BACKUP_AGE_RECIPIENT=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p
