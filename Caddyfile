# ==============================================================================
# GateKeeper-DBF - Caddyfile (Proxy Reverso com TLS Automático)
# CIS Controls v8 (4.1 / 5.5) / OWASP A05:2021
# ==============================================================================

{$DOMAIN:localhost} {
    # Terminação TLS com proxy reverso apontando para a rede interna do Django
    reverse_proxy web:8000 {
        # O Caddy descarta cabeçalhos X-Forwarded-* não confiáveis de clientes externos
        # e insere seus próprios cabeçalhos com o IP real de conexão.
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    # /healthz/ existe só para o health check interno do container (Fase 9.2).
    # Para quem vem de fora, a rota não existe.
    @healthz path /healthz /healthz/
    respond @healthz 404

    # Compressão gzip e zstd para resposta eficiente
    encode gzip zstd

    # Headers de Segurança adicionais na borda
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logs em formato JSON para ingestão em SIEM
    log {
        output stdout
        format json
    }
}
