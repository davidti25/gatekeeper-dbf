docs/privado/
docs/sigiloso/
docs/levantamentos_reais/
# Planos de ação internos (achados de segurança ainda não corrigidos)
docs/action-plan/
*.xlsx
*.xls
*.csv

# --- Credenciais, Chaves e Variáveis de Ambiente ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# --- Banco de Dados Local & Backups (Contém dados reais de teste/operação) ---
*.sqlite3
*.sqlite3-journal
db.sqlite3
backups/
*.sql.gz
*.dump
*.age
*.enc

